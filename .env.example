# Local Compose. Use URL-safe random passwords for the database URL.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
HASURA_GRAPHQL_ADMIN_SECRET=replace-with-another-random-password
# Own PostgreSQL (Neon direct connection or the local database).
DATABASE_URL=postgresql://pokeapi:password@localhost:5432/pokeapi
# Own backend. This is the only GraphQL setting needed by the Worker.
GRAPHQL_BACKEND_URL=http://localhost:8080/v1beta2
# Optional Hasura reference, only for compatibility checks / rollback.
HASURA_GRAPHQL_URL=http://localhost:18080/v1/graphql
REFERENCE_GRAPHQL_URL=http://localhost:18080/v1/graphql
