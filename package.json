{
  "name": "poke-api-komplete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:build": "vendor/pokeapi/.venv/bin/python scripts/build_data.py",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "node tests/api.test.js && node tests/edge-cache.test.js && node tests/snapshot-cache.test.js && node tests/backend.regression.test.js",
    "test:backend": "node tests/backend.regression.test.js",
    "test:compatibility": "node tests/backend.compatibility.test.js",
    "start": "node --max-old-space-size=192 src/backend/server.js",
    "test:http": "node --max-old-space-size=256 tests/backend.http.test.js",
    "benchmark:sql": "node --max-old-space-size=192 scripts/benchmark_sql.mjs",
    "benchmark:local": "node --max-old-space-size=192 scripts/benchmark_local.mjs",
    "benchmark": "node --max-old-space-size=192 scripts/benchmark_backend.mjs",
    "graphql:seed": "vendor/pokeapi/.venv/bin/python scripts/seed_graphql.py",
    "graphql:metadata": "vendor/pokeapi/.venv/bin/python scripts/apply_hasura_metadata.py",
    "graphql:schema": "node scripts/capture_graphql_schema.mjs",
    "test:integration": "node tests/graphql.integration.test.js",
    "audit:rest": "node scripts/audit_rest.mjs",
    "audit:rest:full": "node scripts/audit_rest.mjs --full"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "graphql": "^17.1.0",
    "pg": "^8.23.1"
  }
}
